{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "browser-presentation-request.schema.v1.json",
  "type": "object",
  "required": ["requestId", "walkthroughId", "surface", "viewportProfile", "scenes"],
  "properties": {
    "requestId": {"type": "string", "minLength": 1},
    "walkthroughId": {"type": "string", "minLength": 1},
    "surface": {
      "type": "object",
      "required": ["surfaceId", "kind"],
      "properties": {
        "surfaceId": {"type": "string", "minLength": 1},
        "kind": {"enum": ["repository-web", "documentation-web", "custom-web-viewer"]},
        "baseReference": {"type": "string"}
      },
      "additionalProperties": false
    },
    "viewportProfile": {"enum": ["desktop-standard", "desktop-wide", "mobile-portrait"]},
    "scenes": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "walkthrough-scene.schema.v1.json"}
    }
  },
  "additionalProperties": false
}
