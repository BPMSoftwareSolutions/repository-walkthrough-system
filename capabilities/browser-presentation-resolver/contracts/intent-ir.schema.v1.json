{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "intent-ir.schema.v1.json",
  "type": "object",
  "required": ["capabilityId", "title", "purpose", "actor", "trigger", "desiredOutcome", "constraints", "featureIds"],
  "properties": {
    "capabilityId": {"type": "string", "minLength": 1},
    "title": {"type": "string", "minLength": 1},
    "purpose": {"type": "string", "minLength": 1},
    "actor": {"type": "string", "minLength": 1},
    "trigger": {"type": "string", "minLength": 1},
    "desiredOutcome": {"type": "string", "minLength": 1},
    "constraints": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "featureIds": {"type": "array", "minItems": 1, "items": {"type": "string"}}
  },
  "additionalProperties": false
}
