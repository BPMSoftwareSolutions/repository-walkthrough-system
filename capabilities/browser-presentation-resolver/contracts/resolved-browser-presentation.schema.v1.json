{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "resolved-browser-presentation.schema.v1.json",
  "type": "object",
  "required": ["planId", "requestId", "walkthroughId", "surface", "viewport", "scenes", "disposition"],
  "properties": {
    "planId": {"type": "string", "minLength": 1},
    "requestId": {"type": "string", "minLength": 1},
    "walkthroughId": {"type": "string", "minLength": 1},
    "surface": {
      "type": "object",
      "required": ["surfaceId", "kind", "resolverProfileId"],
      "properties": {
        "surfaceId": {"type": "string"},
        "kind": {"type": "string"},
        "resolverProfileId": {"type": "string"}
      },
      "additionalProperties": false
    },
    "viewport": {
      "type": "object",
      "required": ["profileId", "width", "height", "deviceScaleFactor"],
      "properties": {
        "profileId": {"type": "string"},
        "width": {"type": "integer", "minimum": 1},
        "height": {"type": "integer", "minimum": 1},
        "deviceScaleFactor": {"type": "number", "exclusiveMinimum": 0}
      },
      "additionalProperties": false
    },
    "scenes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["sceneId", "sequence", "operations"],
        "properties": {
          "sceneId": {"type": "string"},
          "sequence": {"type": "integer", "minimum": 1},
          "operations": {
            "type": "array",
            "minItems": 1,
            "items": {"$ref": "browser-presentation-operation.schema.v1.json"}
          }
        },
        "additionalProperties": false
      }
    },
    "disposition": {"enum": ["AUTHORIZED", "REJECTED"]},
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["findingId", "code", "message"],
        "properties": {
          "findingId": {"type": "string"},
          "code": {"type": "string"},
          "message": {"type": "string"},
          "sceneId": {"type": "string"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
