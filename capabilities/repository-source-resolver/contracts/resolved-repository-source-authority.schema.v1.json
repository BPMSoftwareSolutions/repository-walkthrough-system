{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "resolved-repository-source-authority.schema.v1.json",
  "title": "Resolved Repository Source Authority",
  "type": "object",
  "additionalProperties": false,
  "required": ["authorityType", "disposition", "request", "recognizedReference", "operations"],
  "properties": {
    "authorityType": { "const": "resolved-repository-source-resolution-authority.v1" },
