    "request": { "$ref": "repository-source-request.schema.v1.json" },
    "recognizedReference": { "$ref": "recognized-repository-reference.schema.v1.json" },
    "operations": {
      "type": "array",
      "minItems": 8,
      "items": { "type": "string" }
    }
  },
  "x-status": "implemented-first-slice"
}
