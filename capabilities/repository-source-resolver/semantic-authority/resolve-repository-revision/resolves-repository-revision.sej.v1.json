{
  "semanticType": "decision-catalog.v1",
  "responsibilityId": "resolve-repository-revision",
  "status": "implemented-first-slice",
  "decisionId": "resolve-repository-revision-disposition",
  "inputs": [
    "request.revision.present",
    "request.revision.kindHint",
    "request.revision.value",
    "observed.defaultBranch"
  ],
  "rules": [
    {
      "when": {
        "request.revision.present": false,
        "observed.defaultBranch.present": true
      },
      "then": "resolve-default-branch-to-commit"
    },
    {
      "when": {
        "request.revision.kindHint": "branch"
      },
      "then": "resolve-branch-to-commit"
    },
    {
      "when": {
        "request.revision.kindHint": "tag"
      },
      "then": "resolve-tag-to-commit"
    },
    {
      "when": {
        "request.revision.kindHint": "commit",
        "request.revision.value": {
          "matches": "^[0-9a-fA-F]{40}$"
        }
      },
      "then": "authorize-explicit-commit-after-observation"
    },
    {
      "when": {
        "request.revision.present": true
      },
      "then": "reject-revision-not-immutable"
    },
    {
      "when": {
        "*": true
      },
      "then": "reject-revision-unresolvable"
    }
  ],
  "observationDispositionRules": [
    {
      "when": {
        "revisionObservation.status": "observed",
        "revisionObservation.commit": {
          "matches": "^[0-9a-f]{40}$"
        },
        "explicitCommitIdentity": {
          "absentOrEquals": "$revisionObservation.commit"
        }
      },
      "then": "authorize-immutable-revision"
    },
    {
      "when": {
        "revisionObservation.status": "not-found"
      },
      "then": "reject-revision-not-found"
    },
    {
      "when": {
        "*": true
      },
      "then": "reject-revision-not-immutable"
    }
  ],
  "fallbackPolicy": "no-implicit-fallback"
}
